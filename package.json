{
  "name": "mindhub",
  "version": "2.0.0",
  "description": "MindHub — yoshlar boshqaradigan, AI asosidagi fuqarolik tashabbuslari platformasi (Cloudflare Workers)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply mindhub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mindhub-db --remote",
    "db:seed:local": "wrangler d1 execute mindhub-db --local --file=./migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute mindhub-db --remote --file=./migrations/seed.sql",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
