# MindHub — muhit o'zgaruvchilari namunasi.
# Bu faylni .env ga nusxalab, qiymatlarni to'ldiring (.env repoga tushmaydi).

# --- Majburiy ---
# Token va parollarni imzolash kaliti. Uzun, tasodifiy satr bo'lsin.
# O'zgartirilsa BARCHA sessiya va parollar ishlamay qoladi — ehtiyot bo'ling.
SECRET=
# PostgreSQL ulanish satri
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindhub

# --- Ixtiyoriy, lekin tavsiya etiladi ---
# Saytning tashqi manzili (parol tiklash havolalari uchun)
APP_URL=https://example.uz
# Yuklangan fayllar uchun doimiy papka (Railway volume yo'li)
DATA_DIR=/data

# --- Telegram (bog'lash + Telegram bilan kirish) ---
# @BotFather dan oling. Eski token git tarixida ochilgan — uni /revoke qiling!
TG_BOT_TOKEN=
TG_BOT_NAME=mind_hubbot
# Telegram botni o'chirish uchun: ENABLE_TG_BOT=0
ENABLE_TG_BOT=1

# --- Email (parol tiklash kodi) ---
# Resend tavsiya etiladi:
RESEND_API_KEY=
RESEND_FROM=MindHub <onboarding@resend.dev>
# Yoki Gmail SMTP (app password). Eski parol git tarixida ochilgan — yangilang!
SMTP_USER=
SMTP_PASS=
